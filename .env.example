# The database the console owns. REQUIRED, and the only one in this product.
DATABASE_URL=postgresql://user:password@localhost:5432/gadget_console

# The token the bridge presents on /api/bridge/*. REQUIRED, at least 16
# characters. It is the bridge's credential and is never sent to a device.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BRIDGE_TOKEN=

# The console listens on 3001, set by the npm scripts rather than here: `next
# start` reads PORT before it loads this file. The interview client owns 3000 on
# a development machine.

# Deployment figures. Each has a default in src/lib/config.ts.
#SESSION_TTL_MS=2592000000
#CLAIM_TTL_MS=600000
#CLAIM_APPROVAL_TTL_MS=86400000
#RETENTION_DAYS=90

# The cleanup run. An unowned device row is removed once it is this old and no
# live code or pending approval still names it; the run happens this often, and
# removes at most PRUNE_BATCH rows of each kind per pass. PRUNE_INTERVAL_MS=0
# turns the timer off for a deployment that calls `npm run prune` instead.
#UNCLAIMED_DEVICE_TTL_MS=604800000
#PRUNE_INTERVAL_MS=21600000
#PRUNE_BATCH=1000

# Encrypts every account's LLM key at rest. REQUIRED, exactly 32 bytes, base64.
# A profile stored under no key is one nobody can ever decrypt, so this is read
# at start rather than at the first save. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#LLM_KEY_SECRET=
